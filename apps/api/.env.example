NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Comma-separate multiple origins to allow more than one during local dev,
# e.g. testing from a LAN IP: http://localhost:5173,http://10.20.0.3:5173
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=thenarsis
DB_USER=thenarsis_user
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=strict

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

LOG_LEVEL=info

# General API traffic and failed login protection.
API_RATE_LIMIT_WINDOW_MS=300000
API_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=20

# Used only by scripts/migrate-pocketbase-data.js
PB_EXPORT_DIR=
